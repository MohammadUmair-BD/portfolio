# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Optional. Your public address if you use a custom domain. On Vercel the address is
# detected automatically, so leave this unset unless you add your own domain.
SITE_URL=

# Free Neon Postgres connection string. Optional: without it the chat still
# works, but misses aren't logged, custom answers and the contact form are off.
DATABASE_URL=

# Password for /admin (12+ characters). Leave empty to disable the admin page.
ADMIN_PASSWORD=

# Optional. Google Search Console "HTML tag" verification: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional. Salt for hashing visitors' network addresses in the rating anti-spam check.
# Defaults to a value derived from DATABASE_URL.
RATING_SALT=
